# Copy to .env — never commit the real thing.
#
# One process, one Tailscale node, several tailnets' worth of data. The
# sidecar below only ever joins ONE tailnet (whichever you want to serve
# the page FROM); every tailnet listed in tailnets.toml just needs its own
# OAuth client here — no node membership required for those.

# One-off auth key for the Tailscale sidecar. Create it TAGGED (e.g. tag:server)
# so the node is owned by the tag rather than by you personally; in a
# default-deny tailnet an untagged node ends up reachable by nobody.
TS_AUTHKEY=tskey-auth-...

# Node name in your tailnet -> https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=tailnet-atlas

# Timestamp timezone shown on the page.
TZ=UTC

# ---------------------------------------------------------------------------
# Per-tailnet OAuth clients (Settings -> OAuth clients on THAT tailnet).
# Read-only is enough: scopes `devices:core:read` and `policy_file:read`.
# Variable names must match tailnets.toml's oauth_id_env/oauth_secret_env —
# that's what lets several tailnets' credentials live in one .env without
# one clobbering another. See tailnets.example.toml.
# ---------------------------------------------------------------------------

TS_OAUTH_CLIENT_ID_EXAMPLE_ONE=...
TS_OAUTH_SECRET_EXAMPLE_ONE=tskey-client-...
